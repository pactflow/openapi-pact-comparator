{
  "type": "record",
  "name": "OrderCreated",
  "namespace": "orders",
  "doc": "Order Service schema v2. Tags [An]/[Nn] map to the README.",
  "fields": [
    { "name": "order_id", "type": "string" },
    { "name": "total_cents", "type": "long" },
    {
      "name": "currency_code",
      "type": "string",
      "default": "USD",
      "aliases": ["currency"]
    },
    {
      "name": "status",
      "type": {
        "type": "enum",
        "name": "OrderStatus",
        "symbols": ["PENDING", "PAID", "SHIPPED", "REFUNDED"]
      }
    },
    {
      "name": "items",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "LineItem",
          "fields": [
            { "name": "sku", "type": "string" },
            { "name": "quantity", "type": "long" },
            { "name": "unit_price_cents", "type": "long" }
          ]
        }
      }
    },
    {
      "name": "created_at",
      "type": { "type": "long", "logicalType": "timestamp-micros" }
    },
    {
      "name": "shipping_address",
      "type": [
        "null",
        {
          "type": "record",
          "name": "Address",
          "fields": [
            { "name": "line1", "type": "string" },
            { "name": "city", "type": "string" },
            { "name": "postcode", "type": "string" }
          ]
        }
      ],
      "default": null
    },
    { "name": "sales_channel", "type": "string" }
  ]
}
