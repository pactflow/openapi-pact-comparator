{
  "name": "@pactflow/openapi-pact-comparator",
  "version": "2.3.3",
  "description": "An OpenAPI Specification and Pact Comparison library",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "bin": {
    "opc": "dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup --config",
    "build:watch": "rollup --config --watch",
    "changeset:add": "changeset add",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version",
    "knip": "knip",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "patch-package": "patch-package",
    "prepare": "patch-package && npm run build",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --cache --list-different --write .",
    "start": "node dist/cli.mjs",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --project tsconfig.json"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pactflow/openapi-pact-comparator.git"
  },
  "author": {
    "name": "Voon Siong Wong",
    "email": "voon.wong@smartbear.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@sinclair/typebox": "0.34.52",
    "@tsconfig/node22": "22.0.6",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.19.1",
    "@types/qs": "6.15.1",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "15.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "find-my-way": "9.9.0",
    "js-yaml": "5.4.3",
    "knip": "6.40.0",
    "lodash-es": "4.18.1",
    "openapi-types": "12.1.3",
    "parse-multipart-data": "1.5.0",
    "patch-package": "8.0.1",
    "prettier": "3.9.9",
    "qs": "6.16.0",
    "rollup": "4.64.2",
    "tslib": "2.8.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "imports": {
    "#compare/*": "./src/compare/*.ts",
    "#documents/*": "./src/documents/*.ts",
    "#results/*": "./src/results/*.ts",
    "#transform/*": "./src/transform/*.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
